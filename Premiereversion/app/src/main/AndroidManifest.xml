<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PremiereVersion"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".LoadingActivity"
            android:exported="false" />

        <receiver
            android:name=".NotificationReceiver"
            android:exported="true" />

        <activity
            android:name=".Reservation"
            android:exported="false" />
        <activity
            android:name=".VolAdapter"
            android:exported="false"
            tools:ignore="Instantiatable" />
        <activity
            android:name=".MesVols"
            android:exported="false" />
        <activity
            android:name=".DetailCompte"
            android:exported="false" />
        <activity
            android:name=".Notification"
            android:exported="false" />
        <activity
            android:name=".Recherche"
            android:exported="false" />
        <activity
            android:name=".AdminPage"
            android:exported="false" />
        <activity
            android:name=".PageApresLogin"
            android:exported="false" />
        <activity
            android:name=".Creercompte"
            android:exported="false" />
        <activity
            android:name=".Login"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>