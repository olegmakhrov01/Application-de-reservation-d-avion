<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background">

    <TextView
        android:id="@+id/textPrix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prix: 700$"
        android:textSize="18sp"
        android:textColor="#03A9F4"
        android:textStyle="bold"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>

    <LinearLayout
        android:id="@+id/infoLayout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textPrix"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textDepart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Départ: 10:00"
            android:textSize="18sp"
            android:textColor="#333333"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/textDuree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sans arrêt - 2h 28m"
            android:textColor="#333333"
            android:textSize="18sp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/textDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destination: Lyon"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/buttonReserver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/infoLayout"
        android:layout_marginTop="12dp"
        android:text="Voir les offres"
        android:backgroundTint="#001F54"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="10dp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/textDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Date: 12 Oct 2023"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />
</RelativeLayout>